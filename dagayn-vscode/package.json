{
  "name": "dagayn",
  "displayName": "Dagayn",
  "description": "Visualize code dependencies, blast radius, and review context from your dagayn database directly in VS Code.",
  "version": "0.2.2",
  "publisher": "tirth8205",
  "license": "MIT",
  "icon": "media/icons/icon.png",
  "keywords": [
    "code analysis",
    "graph",
    "visualization",
    "dependencies",
    "blast radius",
    "code review",
    "tree-sitter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tirth8205/code-review-graph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.dagayn/graph.db",
    "onCommand:dagayn.*",
    "onView:dagayn.*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dagayn",
          "title": "Code Graph",
          "icon": "media/icons/graph.svg"
        }
      ]
    },
    "views": {
      "dagayn": [
        {
          "id": "dagayn.codeGraph",
          "name": "Code Graph"
        },
        {
          "id": "dagayn.blastRadius",
          "name": "Blast Radius"
        },
        {
          "id": "dagayn.stats",
          "name": "Stats"
        }
      ]
    },
    "commands": [
      {
        "command": "dagayn.showBlastRadius",
        "title": "Code Graph: Show Blast Radius",
        "icon": "$(pulse)"
      },
      {
        "command": "dagayn.findCallers",
        "title": "Code Graph: Find Callers",
        "icon": "$(references)"
      },
      {
        "command": "dagayn.findTests",
        "title": "Code Graph: Find Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "dagayn.queryGraph",
        "title": "Code Graph: Query Graph",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "dagayn.findCallees",
        "title": "Code Graph: Find Callees",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "dagayn.findLargeFunctions",
        "title": "Code Graph: Find Large Functions",
        "icon": "$(warning)"
      },
      {
        "command": "dagayn.showGraph",
        "title": "Code Graph: Show Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dagayn.search",
        "title": "Code Graph: Search",
        "icon": "$(search)"
      },
      {
        "command": "dagayn.reviewChanges",
        "title": "Code Graph: Review Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "dagayn.embedGraph",
        "title": "Code Graph: Compute Embeddings",
        "icon": "$(sparkle)"
      },
      {
        "command": "dagayn.watchGraph",
        "title": "Code Graph: Watch Mode",
        "icon": "$(eye)"
      },
      {
        "command": "dagayn.buildGraph",
        "title": "Code Graph: Build Graph",
        "icon": "$(database)"
      },
      {
        "command": "dagayn.updateGraph",
        "title": "Code Graph: Update Graph",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dagayn.findCallers",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@1"
        },
        {
          "command": "dagayn.findCallees",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@2"
        },
        {
          "command": "dagayn.findTests",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@3"
        },
        {
          "command": "dagayn.showBlastRadius",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "dagayn.findCallers",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@1"
        },
        {
          "command": "dagayn.findCallees",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@2"
        },
        {
          "command": "dagayn.findTests",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@3"
        },
        {
          "command": "dagayn.showBlastRadius",
          "when": "editorTextFocus",
          "group": "dagayn.codeGraph@4"
        }
      ],
      "scm/title": [
        {
          "command": "dagayn.reviewChanges",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/item/context": [
        {
          "command": "dagayn.showBlastRadius",
          "when": "viewItem =~ /node-/",
          "group": "codeGraph@1"
        },
        {
          "command": "dagayn.findCallers",
          "when": "viewItem =~ /node-/",
          "group": "codeGraph@2"
        },
        {
          "command": "dagayn.findCallees",
          "when": "viewItem =~ /node-/",
          "group": "codeGraph@3"
        },
        {
          "command": "dagayn.findTests",
          "when": "viewItem =~ /node-/",
          "group": "codeGraph@4"
        },
        {
          "command": "dagayn.showGraph",
          "when": "viewItem =~ /node-/",
          "group": "codeGraph@5"
        }
      ]
    },
    "configuration": {
      "title": "Dagayn",
      "properties": {
        "dagayn.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the dagayn CLI binary. Leave empty to use the bundled version or the one found on PATH."
        },
        "dagayn.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update the graph database when files are saved."
        },
        "dagayn.autoUpdateFailureThreshold": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "multipleOf": 1,
          "scope": "window",
          "description": "Number of consecutive auto-update failures before a warning notification is shown. Set to 1 to notify on the first failure."
        },
        "dagayn.blastRadiusDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum depth for blast radius traversal."
        },
        "dagayn.graphTheme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "description": "Color theme for the graph visualization. 'auto' follows the VS Code theme."
        },
        "dagayn.treeView.showFunctions": {
          "type": "boolean",
          "default": true,
          "description": "Show function nodes in the tree view."
        },
        "dagayn.treeView.showClasses": {
          "type": "boolean",
          "default": true,
          "description": "Show class nodes in the tree view."
        },
        "dagayn.treeView.showFiles": {
          "type": "boolean",
          "default": true,
          "description": "Show file nodes in the tree view."
        },
        "dagayn.treeView.showTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show type nodes in the tree view."
        },
        "dagayn.treeView.showTests": {
          "type": "boolean",
          "default": true,
          "description": "Show test nodes in the tree view."
        },
        "dagayn.graph.defaultEdges": {
          "type": "array",
          "default": [
            "CALLS",
            "IMPORTS_FROM",
            "INHERITS",
            "IMPLEMENTS",
            "TESTED_BY",
            "DEPENDS_ON"
          ],
          "items": {
            "type": "string",
            "enum": [
              "CALLS",
              "IMPORTS_FROM",
              "INHERITS",
              "IMPLEMENTS",
              "CONTAINS",
              "TESTED_BY",
              "DEPENDS_ON"
            ]
          },
          "description": "Edge types shown by default in the graph visualization."
        },
        "dagayn.graph.maxNodes": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 5000,
          "description": "Maximum number of nodes to display in the graph visualization."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "dagayn.welcome",
        "title": "Get Started with Dagayn",
        "description": "Build a code graph and explore your codebase visually.",
        "steps": [
          {
            "id": "dagayn.welcome.install",
            "title": "Install the CLI",
            "description": "Install the dagayn CLI tool to build your graph database.\n\n[Install CLI](command:dagayn.walkthrough.install)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            }
          },
          {
            "id": "dagayn.welcome.build",
            "title": "Build Your Graph",
            "description": "Run the build command to analyze your codebase and create a graph database.\n\n[Build Graph](command:dagayn.buildGraph)",
            "media": {
              "markdown": "media/walkthrough/build.md"
            }
          },
          {
            "id": "dagayn.welcome.explore",
            "title": "Explore the Graph",
            "description": "Open the Code Graph panel in the activity bar to explore your code's structure, blast radius, and review context.\n\n[Open Code Graph](command:dagayn.walkthrough.explore)",
            "media": {
              "markdown": "media/walkthrough/explore.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package",
    "lint": "tsc --noEmit",
    "fmt": "biome check --write --unsafe .",
    "fmt:check": "biome check .",
    "test": "mocha",
    "test:compile": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vscode": "file:./test/vscode-stub-package"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "d3": "^7.9.0"
  },
  "packageManager": "pnpm@11.6.0"
}
