Accept tilde (~) token in macro token trees

From https://github.com/tree-sitter/tree-sitter-rust/pull/317 (grammar.js and
tests only; the generated files are regenerated). Drop this patch once the
pin includes the PR.

diff --git a/grammar.js b/grammar.js
index 4a0ff4b6..968efa22 100644
--- a/grammar.js
+++ b/grammar.js
@@ -53,6 +53,7 @@ const TOKEN_TREE_NON_SPECIAL_PUNCTUATION = [
   '>>', '+=', '-=', '*=', '/=', '%=', '^=', '&=', '|=', '<<=',
   '>>=', '=', '==', '!=', '>', '<', '>=', '<=', '@', '_', '.',
   '..', '...', '..=', ',', ';', ':', '::', '->', '=>', '#', '?',
+  '~',
 ];
 
 const primitiveTypes = numericTypes.concat(['bool', 'str', 'char']);
diff --git a/test/corpus/macros.txt b/test/corpus/macros.txt
